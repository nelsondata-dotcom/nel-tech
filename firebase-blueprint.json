{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "preferences": { "type": "object" },
        "businessProfile": { "type": "object" }
      },
      "required": ["uid", "email", "role"]
    },
    "FinancialRecord": {
      "title": "Financial Record",
      "description": "Monthly financial data for an SME",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "revenue": { "type": "number" },
        "costOfSales": { "type": "number" },
        "operatingExpenses": { "type": "number" },
        "cashBalance": { "type": "number" },
        "currentAssets": { "type": "number" },
        "currentLiabilities": { "type": "number" },
        "totalAssets": { "type": "number" },
        "totalLiabilities": { "type": "number" },
        "equity": { "type": "number" },
        "loanRepayments": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "period", "revenue"]
    },
    "ChatThread": {
      "title": "Chat Thread",
      "description": "History of AI assistant interactions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "messages": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "messages"]
    },
    "FinancialReport": {
      "title": "Financial Report",
      "description": "Saved financial reports generated by the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string" },
        "period": { "type": "string" },
        "content": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "Global website content like home page text and banners",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "content": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "content"]
    },
    "EducationArticle": {
      "title": "Education Article",
      "description": "Financial literacy articles for SMEs",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "category"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "System-wide alerts and updates",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "critical"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "active", "createdAt"]
    },
    "BankMetric": {
      "title": "Bank Metric",
      "description": "Financial performance data for a Ghanaian bank",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "car": { "type": "number" },
        "npl": { "type": "number" },
        "totalAssets": { "type": "number" },
        "marketShare": { "type": "number" },
        "profitBeforeTax": { "type": "number" },
        "roa": { "type": "number" },
        "strengths": { "type": "array" },
        "weaknesses": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "car", "npl", "totalAssets"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles including business info and preferences"
    },
    "/users/{userId}/financialRecords/{recordId}": {
      "schema": "FinancialRecord",
      "description": "SME financial data entries"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "ChatThread",
      "description": "AI Assistant chat threads"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": "FinancialReport",
      "description": "Saved financial reports"
    },
    "/siteContent/{contentId}": {
      "schema": "SiteContent",
      "description": "Global website configurations"
    },
    "/educationArticles/{articleId}": {
      "schema": "EducationArticle",
      "description": "Public educational content"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "System-wide announcements"
    },
    "/bankMetrics/{bankId}": {
      "schema": "BankMetric",
      "description": "Ghanaian bank performance data"
    }
  }
}
